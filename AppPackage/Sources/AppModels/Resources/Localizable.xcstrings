    "thumbnail_load_timing.on_mouse_over_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiten laden schneller, Vorschaubilder erscheinen aber unter Umständen leicht verzögert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages load faster, but there may be a slight delay before a thumb appears."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページの読み込みが速くなりますが、サムネイルの表示はちょっぴり遅れてきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지가 더 빨리 로드되지만 썸네일이 나타나기 전까지 약간의 지연이 있을 수 있어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницы загружаются быстрее, но миниатюра может появляться с небольшой задержкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面的加载速度更快，但缩略图出现的时间可能稍有延迟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網頁的載入速度更快，但縮圖出現的時間可能稍有延遲。"
          }
        }
      }
    },
    "thumbnail_load_timing.on_page_load": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Laden der Seite"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On page load"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ読み込み時"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지 로드될 때"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При загрузке страницы"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面加载时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網頁載入時"
          }
        }
      }
    },
    "thumbnail_load_timing.on_page_load_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiten brauchen länger zum Laden, dafür erscheinen die Vorschaubilder danach ohne Verzögerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages take longer to load, but there is no delay for loading a thumb after the page has loaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページの読み込み時間が増えますが、サムネイルはすぐに表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지 로드에 시간이 더 오래 걸리지만, 페이지가 로드된 후 썸네일을 로드하는데 지연이 없어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницы загружаются дольше, но после загрузки миниатюры появляются без задержки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面加载时间更长，显示缩略图无需等待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網頁需要更多的載入時間，但是在網頁完全載入後縮圖顯示不會有任何延遲。"
          }
        }
      }
    },
