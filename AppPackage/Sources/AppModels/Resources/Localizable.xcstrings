    "app_error.cloudflare_challenge_failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare-Prüfung fehlgeschlagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Verification Failed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareの認証に失敗しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 인증 실패"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка Cloudflare не пройдена"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 验证失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 驗證失敗"
          }
        }
      }
    },
    "app_error.cloudflare_challenge_failed_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloudflare-Prüfung ist auch nach mehreren Versuchen fehlgeschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare’s verification couldn’t be completed after repeated attempts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何度か試しましたが、Cloudflareの認証を完了できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 번 시도했지만 Cloudflare 인증을 완료하지 못했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось пройти проверку Cloudflare после нескольких попыток."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多次尝试后仍无法完成 Cloudflare 验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多次嘗試後仍無法完成 Cloudflare 驗證。"
          }
        }
      }
    },
    "app_error.cloudflare_challenge_solution": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich über den Browser oben rechts im Anmeldebildschirm an oder gib deine Cookies manuell unter „Einstellungen > Konto“ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in through the browser at the top right of the login screen, or enter your cookies in Settings > Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン画面右上のブラウザからログインするか、「設定 > アカウント」でCookieを手動で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 화면 오른쪽 위의 브라우저에서 로그인하거나, ‘설정 > 계정’에서 쿠키를 직접 입력해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите через браузер в правом верхнем углу экрана входа или введите cookie в разделе «Настройки» > «Аккаунт»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请通过登录界面右上角的浏览器登录，或在“设置 > 账号”中手动输入 Cookie。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請透過登入畫面右上角的瀏覽器登入，或在「設定 > 帳號」中手動輸入 Cookie。"
          }
        }
      }
    },
