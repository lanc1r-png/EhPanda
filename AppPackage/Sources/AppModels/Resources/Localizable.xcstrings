    "load_through_hath_setting.default_port_only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Clients mit Standardport"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default port clients only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトポートのクライアントのみ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 포트 클라이언트만"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только клиенты на порту по умолчанию"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用默认端口的客户端"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只使用預設連接埠的用戶端"
          }
        }
      }
    },
    "load_through_hath_setting.default_port_only_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsamer. Nur verwenden, wenn eine Firewall oder ein Proxy ausgehende Nicht-Standard-Ports blockiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slower. Use only if behind a firewall or proxy that blocks outgoing non-standard ports."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅くなります。非標準発信ポートがファイヤーウォール・プロキシにブロックされた場合のみ有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 느려요. 나가는 비표준 포트를 차단하는 방화벽/프록시가 있는 경우에만 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленнее. Используйте только за брандмауэром или прокси, блокирующим исходящие соединения на нестандартные порты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较慢。仅在防火墙或代理阻止非标准端口的出站流量时启用此项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較慢。僅在網路防火牆或代理伺服器阻擋非標準傳出連接埠時使用這個選項。"
          }
        }
      }
    },
    "load_through_hath_setting.legacy_no": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein [Legacy/HTTP]"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No [Legacy/HTTP]"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使わない [レガシー / HTTP]"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아닙니다 [Legacy/HTTP]"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет [Устаревший/HTTP]"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用 [旧式 / HTTP]"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用 [舊式 / HTTP]"
          }
        }
      }
    },
    "load_through_hath_setting.legacy_no_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Spender. Funktioniert in modernen Browsern unter Umständen nicht. Nur für alte oder veraltete Browser empfohlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Donator only. May not work by default in modern browsers. Recommended for legacy/outdated browsers only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寄付者限定オプション。モダンブラウザでは機能しないこともあります。レガシー・旧型ブラウザの場合以外おすすめしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기부자 전용 기능이에요. 최신 브라우저에서는 제대로 작동하지 않을 수 있어요. 오래된 브라우저에서만 사용해주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для донаторов. В современных браузерах может не работать по умолчанию. Рекомендуется только для старых браузеров."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限赞助者。在现代浏览器可能不可用。只建议在旧式 / 过时的浏览器使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅限贊助者。在現代瀏覽器可能無法使用。只建議在舊式 / 過時的瀏覽器使用。"
          }
        }
      }
    },
    "load_through_hath_setting.modern_no": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein [Modern/HTTPS]"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No [Modern/HTTPS]"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使わない [モダン / HTTPS]"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아닙니다 [Modern/HTTPS]"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет [Современный/HTTPS]"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用 [现代 / HTTPS]"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用 [現代 / HTTPS]"
          }
        }
      }
    },
    "load_through_hath_setting.modern_no_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Spender. Du kannst damit weniger Seiten aufrufen. Nur bei schwerwiegenden Problemen empfohlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Donator only. You will not be able to browse as many pages. Recommended only if having severe problems."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寄付者限定オプション。閲覧できるページ数が少なくなります。深刻な問題が起こった場合以外おすすめしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기부자 전용 기능이에요. 볼 수 있는 페이지 수가 줄어들어요. 심각한 문제가 있는 경우를 제외하고는 사용하지 말아주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для донаторов. Вы сможете просматривать меньше страниц. Рекомендуется только при серьёзных проблемах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限赞助者。可浏览的页面数会减少。只建议在遇到严重问题时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅限贊助者。可瀏覽的頁面數會減少。只建議在遇到嚴重問題時使用。"
          }
        }
      }
    },
    "multiple_page_viewer_style.align_center_always_scale": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zentriert, immer skalieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Align center; Always scale images to fit browser width"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央揃え、常時スケール"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 정렬, 항상 크기 맞추기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По центру; всегда масштабировать изображения по ширине браузера"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "居中对齐，图像始终缩放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "置中對齊且總是縮放"
          }
        }
      }
    },
    "multiple_page_viewer_style.align_center_scale_if_over_width": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zentriert, bei Überbreite skalieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Align center; Only scale if image is larger than browser width"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央揃え、幅によってスケール"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 정렬, 너비 초과할 때 크기 맞추기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По центру; масштабировать, только если изображение шире браузера"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "居中对齐，图像过宽时缩放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "置中對齊，若寬度超出頁面則進行縮放"
          }
        }
      }
    },
    "multiple_page_viewer_style.align_left_scale_if_over_width": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linksbündig, bei Überbreite skalieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Align left; Only scale if image is larger than browser width"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左寄せ、幅によってスケール"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 정렬, 너비 초과할 때 크기 맞추기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
