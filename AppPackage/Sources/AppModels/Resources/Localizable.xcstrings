    "ip_banned": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine IP-Adresse wurde wegen zu vieler Seitenaufrufe vorübergehend gesperrt. Das deutet auf automatisierte Download-Software hin. Verbleibende Sperrzeit: %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your IP address is temporarily banned for excessive page loads, which suggests automated download software. The ban expires in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページの読み込みが多すぎるため、自動収集ツールの使用が疑われ、このIPアドレスは一時的にブロックされました。%@後に解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지 요청이 과도해 자동 다운로드 프로그램을 사용하는 것으로 의심되어 IP 주소가 일시적으로 차단되었습니다. 차단은 %@ 후에 해제됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш IP-адрес временно заблокирован за чрезмерное число загрузок страниц, что похоже на автоматическую программу для скачивания. Блокировка истекает через %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面加载次数过多，疑似使用了自动抓取工具，你的 IP 地址已被暂时封禁。封禁将在 %@后解除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面載入次數過多，疑似使用了自動抓取工具，你的 IP 位址已遭暫時封鎖。封鎖會在 %@後解除。"
          }
        }
      }
    },
    "ip_banned_unknown_duration": {
      "comment": "Shown instead of ip_banned when the site's ban duration could not be parsed.",
      "extractionState": "manual",
      "localizations": {
