    "app_error.login_rejected_solution": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfe Benutzername und Passwort und versuche es erneut.\nWenn es weiterhin fehlschlägt, melde dich über den Browser oben rechts an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your username and password, then try again.\nIf it keeps failing, log in through the browser at the top right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー名とパスワードを確認して、もう一度お試しください。\n失敗が続く場合は、右上のブラウザからログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이디와 비밀번호를 확인한 후 다시 시도해 주세요.\n계속 실패하면 오른쪽 위의 브라우저에서 로그인해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте имя пользователя и пароль и повторите попытку.\nЕсли не получится, войдите через браузер в правом верхнем углу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查用户名和密码后重试。\n如果仍然失败，请通过右上角的浏览器登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查使用者名稱和密碼後再試一次。\n如果仍然失敗，請透過右上角的瀏覽器登入。"
          }
        }
      }
    },
