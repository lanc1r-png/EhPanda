    "app_error.image_limit_reached_solution": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte, bis dein Kontingent zurückgesetzt wurde, und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for your limit to reset, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧上限がリセットされてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할당량이 초기화된 후 다시 시도해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь сброса лимита и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待配额重置后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請等額度重設後再試。"
          }
        }
      }
    },
