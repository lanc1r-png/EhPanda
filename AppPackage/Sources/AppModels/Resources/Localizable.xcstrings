    "app_error.login_rejected_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Website hat die Anmeldung ohne Angabe von Gründen abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The site refused the login without saying why."
          }
        },
        "ja": {
